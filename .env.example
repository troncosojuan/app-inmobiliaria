# Único archivo de entorno: raíz del proyecto.
# Lo usan las apps (web/admin) y Prisma (db push, seed, studio) cuando corrés desde el monorepo.

# Database (local: SQLite | producción/Neon: PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_inmobiliaria?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="cambiar-en-produccion"
NEXTAUTH_URL="http://localhost:3000"

# Storage (Cloudflare R2 / AWS S3 compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="inmobiliaria-assets"
S3_REGION="auto"

# Platform (para Vercel: tu dominio, ej. tu-app.vercel.app)
PLATFORM_DOMAIN="localhost:3000"
# Tenant que se muestra en la URL principal (slug en DB). Sin esto la home hace notFound().
DEFAULT_TENANT="demo-inmobiliaria"
